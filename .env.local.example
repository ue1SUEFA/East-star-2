# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it contains secrets.

# From @BotFather after /newbot — looks like: 1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=

# Chat ID where leads should be sent. For a private group, this is a negative
# number like -1001234567890. See TELEGRAM_SETUP.md for how to find it.
TELEGRAM_CHAT_ID=

# ---- Meta Pixel (Instagram / Facebook ad tracking) ----
# 15-16 digit Pixel ID from Meta Events Manager. See META_PIXEL_SETUP.md.
# Leave empty to disable the Pixel (e.g. on local dev). Must start with
# NEXT_PUBLIC_ so it's available to the browser.
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Meta Conversions API (server-side, recommended) ----
# Mirrors the browser "Lead" event server-to-server so conversions lost to
# ad-blockers / iOS are still attributed. Uses the same Pixel ID above.
# Token: Events Manager → Data sources → your Pixel → Settings → Conversions API
#        → "Generate access token". Leave empty to disable server-side sending.
META_CAPI_ACCESS_TOKEN=

# (Optional) Paste a Test Event Code from Events Manager → "Test events" to make
# server events show up there while verifying. Remove it for production.
META_CAPI_TEST_EVENT_CODE=

# (Optional) Graph API version. Bump if Meta deprecates the default (v21.0).
# META_GRAPH_VERSION=v21.0
